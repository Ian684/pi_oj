:root {
  color-scheme: light;
  --page: #f2f3ef;
  --surface: #fff;
  --surface-soft: #f8f8f5;
  --text: #17201c;
  --muted: #66736c;
  --line: #dce2dc;
  --accent: #26745d;
  --accent-hover: #1d5d4a;
  --accent-soft: #e4f1eb;
  --danger: #b3261e;
  --shadow: 0 12px 36px rgb(27 43 35 / 7%);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
}

* { box-sizing: border-box; }

html, body {
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--page);
  color: var(--text);
}

header {
  height: 58px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}

header strong {
  font-family: Georgia, serif;
  font-size: 22px;
}

header span {
  margin-left: 10px;
  color: var(--muted);
  font-size: 12px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.timer {
  min-width: 100px;
  padding: 7px 10px;
  border-radius: 7px;
  background: var(--accent-soft);
  color: var(--accent-hover);
  font-weight: 800;
  text-align: center;
}

main {
  height: calc(100vh - 58px);
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 360px;
  gap: 12px;
  padding: 12px;
  overflow: hidden;
}

.exam-sidebar,
.exam-tools,
.exam-workspace {
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.panel,
.exam-workspace {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 9px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.setup-panel {
  padding: 12px;
  display: grid;
  gap: 10px;
}

label {
  display: grid;
  gap: 5px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

select,
button,
textarea {
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
}

select,
button {
  height: 36px;
  padding: 0 10px;
}

button {
  cursor: pointer;
  font-size: 12px;
  font-weight: 800;
}

button:hover {
  border-color: var(--accent);
  color: var(--accent);
}

button:disabled {
  cursor: wait;
  opacity: .55;
}

button.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.setup-actions,
.problem-actions {
  display: flex;
  gap: 8px;
}

.custom-permissions {
  display: grid;
  gap: 6px;
  padding: 8px;
  border: 1px dashed var(--line);
  border-radius: 7px;
  background: var(--surface-soft);
}

.custom-permissions label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
}

.problem-list-panel,
.summary-panel,
.result-panel {
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.problem-list-panel { flex: 1; }
.summary-panel { height: 170px; }

.panel-title,
.result-title {
  height: 42px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.problem-list {
  overflow: auto;
  padding: 8px;
}

.problem-item {
  width: 100%;
  min-height: 48px;
  height: auto;
  margin-bottom: 7px;
  padding: 8px;
  display: grid;
  gap: 4px;
  text-align: left;
  border-color: var(--line);
}

.problem-item.active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.problem-item strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.problem-item span {
  color: var(--muted);
  font-size: 11px;
}

.problem-bar {
  height: 58px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-soft);
}

.problem-bar > div:first-child {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

#problemTitle {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-pill,
.pill {
  display: inline-flex;
  align-items: center;
  min-height: 23px;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-hover);
  font-size: 11px;
  font-weight: 800;
}

.pill.bad {
  background: #ffe9e7;
  color: var(--danger);
}

.pill.ok {
  background: var(--accent-soft);
  color: var(--accent-hover);
}

.pill.neutral {
  background: var(--surface-soft);
  color: var(--muted);
  border: 1px solid var(--line);
}

.code-editor {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: 16px;
  border: 0;
  border-radius: 0;
  resize: none;
  font: 14px/1.55 Consolas, "Courier New", monospace;
  outline: none;
}

.test-box {
  width: 100%;
  height: 145px;
  padding: 12px;
  border: 0;
  border-top: 1px solid var(--line);
  border-radius: 0;
  resize: none;
  font: 13px/1.45 Consolas, "Courier New", monospace;
}

#output,
#summary,
#lastAnswer {
  flex: 1;
  margin: 0;
  padding: 12px;
  overflow: auto;
  white-space: pre-wrap;
  font: 13px/1.5 Consolas, "Courier New", monospace;
}

#toast {
  position: fixed;
  right: 18px;
  bottom: 18px;
  max-width: 420px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  box-shadow: var(--shadow);
  opacity: 0;
  transform: translateY(8px);
  transition: .18s ease;
  pointer-events: none;
}

#toast.show {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1100px) {
  main {
    grid-template-columns: 240px minmax(0, 1fr);
  }

  .exam-tools {
    display: none;
  }
}

