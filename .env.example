# 必須是樹莓派主機上的絕對路徑，不能填容器內的 /sandboxes。
HOST_SANDBOX_ROOT=/home/ian/pi_oj/backend/sandboxes

# UVA 使用者自己的帳密。請勿提交真正的 .env。
UVA_USERNAME=
UVA_PASSWORD=
UVA_LOGIN_MODE=browser

# UVA 表單語言代碼若日後異動，可在此調整。
UVA_C_LANGUAGE_ID=1
UVA_JAVA_LANGUAGE_ID=2
UVA_PASCAL_LANGUAGE_ID=3
UVA_CPP_LANGUAGE_ID=5
UVA_PY_LANGUAGE_ID=6

# AI helper. Keep real keys only in .env, never commit them.
# Choose: gemini or openai.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=3000

# Codeforces submit automation. Leave empty to disable submit.
CODEFORCES_USERNAME=
CODEFORCES_PASSWORD=
CODEFORCES_C_LANGUAGE_ID=43
CODEFORCES_CPP_LANGUAGE_ID=54
CODEFORCES_CPP20_LANGUAGE_ID=73
CODEFORCES_CPP23_LANGUAGE_ID=89
CODEFORCES_JAVA_LANGUAGE_ID=87
CODEFORCES_PY_LANGUAGE_ID=100
CODEFORCES_PYPY_LANGUAGE_ID=72
CODEFORCES_JS_V8_LANGUAGE_ID=34
CODEFORCES_NODE_LANGUAGE_ID=55
CODEFORCES_RUST2021_LANGUAGE_ID=75
CODEFORCES_RUST2024_LANGUAGE_ID=95
CODEFORCES_GO_LANGUAGE_ID=32
CODEFORCES_PERL_LANGUAGE_ID=13
CODEFORCES_PHP_LANGUAGE_ID=6
CODEFORCES_RUBY_LANGUAGE_ID=67
CODEFORCES_OCAML_LANGUAGE_ID=19
CODEFORCES_D_LANGUAGE_ID=28
CODEFORCES_VERDICT_TIMEOUT=90

# Local runner resource/output limits.
# stdout/stderr are captured to files so large output will not fill Docker logs.
OJ_STDOUT_CAPTURE_LIMIT=120000
OJ_STDERR_CAPTURE_LIMIT=40000
OJ_DEFAULT_MEM_LIMIT=128m
OJ_JAVA_MEM_LIMIT=384m
OJ_GO_MEM_LIMIT=256m
OJ_RUN_TIMEOUT=5
OJ_JAVA_RUN_TIMEOUT=8
OJ_GO_RUN_TIMEOUT=8

# Pi OJ private-instance HTTP Basic authentication. Use HTTPS when accessing remotely.
PI_OJ_BASIC_USER=ian
PI_OJ_BASIC_PASSWORD=replace-with-long-random-password
# 127.0.0.1 is the safe default for local ngrok forwarding.
PI_OJ_BIND_HOST=127.0.0.1

# Maximum waiting Celery jobs in the Redis default queue (best effort).
PI_OJ_MAX_QUEUE_DEPTH=20
